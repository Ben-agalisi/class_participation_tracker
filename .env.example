# Copy this file to .env and fill in your real values.
# Keep this file out of version control.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8000,http://localhost:8000
INDEX_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-email@example.com

SMS_GATEWAY_URL=https://sms.arkesel.com/sms/api
SMS_API_KEY=your-arkesel-api-key
SMS_SENDER_ID=your-sender-id

STAFF_INVITATION_TTL_MINUTES=2
MARK_ENTRY_GROUP_NAME=Mark Entry Staff
